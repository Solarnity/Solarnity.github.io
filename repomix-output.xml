// src/components/Riddle/InkText.jsx
import React, { useMemo } from 'react';

export const InkText = ({
  children,
  className = '',
  intensity = 3,          // Fuerza de la deformación principal
  frequency = 0.05,       // Frecuencia del ruido (0.04–0.08 suele funcionar bien)
  octaves = 4,            // Niveles de detalle del ruido
  bleed = 2,              // Cantidad extra de sangrado (se suma a intensity)
  color = 'currentColor',
  paperTexture = false,
}) => {
  // ID único por combinación de parámetros
  const filterId = useMemo(
    () => `ink-bleed-${intensity}-${frequency}-${octaves}-${bleed}`,
    [intensity, frequency, octaves, bleed]
  );

  return (
    <>
      {/* Filtro SVG oculto */}
      <svg className="hidden" aria-hidden="true">
        <defs>
          <filter
            id={filterId}
            x="-10%"   // Evita recortes por desplazamiento
            y="-10%"
            width="120%"
            height="120%"
          >
            {/* Generación de ruido fractal */}
            <feTurbulence
              type="fractalNoise"
              baseFrequency={frequency}
              numOctaves={octaves}
              result="noise"
            />

            {/* Texto principal deformado */}
            <feDisplacementMap
              in="SourceGraphic"
              in2="noise"
              scale={intensity}
              xChannelSelector="R"
              yChannelSelector="G"
              result="displaced"
            />

            {/* Capa de sangrado: mayor desplazamiento + desenfoque */}
            <feDisplacementMap
              in="SourceGraphic"
              in2="noise"
              scale={intensity + bleed}
              xChannelSelector="R"
              yChannelSelector="G"
              result="bleedDisplaced"
            />
            <feGaussianBlur
              in="bleedDisplaced"
              stdDeviation="1.5"
              result="bleedBlur"
            />

            {/* Mezcla final: sangrado detrás del texto principal */}
            <feMerge>
              <feMergeNode in="bleedBlur" />
              <feMergeNode in="displaced" />
            </feMerge>
          </filter>
        </defs>
      </svg>

      <span
        className={`tracking-wide ${className}`}
        style={{
          filter: `url(#${filterId})`,
          color,
          // Textura de papel opcional (punteado sutil)
          ...(paperTexture && {
            backgroundImage:
              'radial-gradient(circle, rgba(0,0,0,0.03) 1px, transparent 1px)',
            backgroundSize: '4px 4px',
          }),
        }}
      >
        {children}
      </span>
    </>
  );
};
</file>

