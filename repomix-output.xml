// src/pages/RiddleGame.jsx
import { useState } from "react";
import Silk from "../components/Riddle/SilkBackground";
import { InkText } from "../components/Riddle/InkText";
import { RiddleMedia } from "../components/Riddle/RiddleMedia";
import { RIDDLE_LEVELS } from "../data/riddleLevels";
import { VigenereCipher } from "../utils/vigenereCipher"; // Asegúrate de exportar la función desde ese archivo

export default function Digital() {
  const [currentLevelIdx, setCurrentLevelIdx] = useState(0);
  const [userInput, setUserInput] = useState("");
  const [error, setError] = useState(false);

  const level = RIDDLE_LEVELS[currentLevelIdx];
  const totalLevels = RIDDLE_LEVELS.length;

  const handleSubmit = (e) => {
    e.preventDefault();
    // Usamos VigenereCipher con decrypt = true
    const decrypted = VigenereCipher(level.encryptedSuccessToken, userInput, true);

    if (decrypted.includes(`SUCCESS_TOKEN_${level.id}`)) {
      setError(false);
      setUserInput("");
      if (currentLevelIdx + 1 < totalLevels) {
        setCurrentLevelIdx((prev) => prev + 1);
      } else {
        alert("🎉 ¡Has completado los 21 niveles!");
      }
    } else {
      setError(true);
      // Pequeño efecto de sacudida en el input (opcional)
    }
  };

  // Calcular progreso
  const progress = ((currentLevelIdx + 1) / totalLevels) * 100;

  return (
    <div className="relative min-h-screen w-full bg-[#0b0b1a] text-white flex flex-col items-center justify-center p-4 overflow-hidden">
      {/* Fondo Silk con opacidad reducida para resaltar el glass */}
      <div className="absolute inset-0 z-0 pointer-events-none opacity-40">
        <Silk
          speed={1.7}
          scale={0.8}
          color="#e23f31"      // Cambio a un violeta más moderno
          noiseIntensity={2.7}
          rotation={0}
        />
      </div>

      {/* Contenedor principal con efecto glass */}
      <main className="relative z-10 w-full max-w-2xl
                      bg-white/5 backdrop-blur-xl
                      border border-white/10
                      rounded-2xl p-8
                      shadow-[0_8px_32px_rgba(0,0,0,0.6)]
                      transition-all duration-500
                      hover:shadow-[0_8px_48px_rgba(108,60,224,0.3)]">
        
        {/* Cabecera con título y progreso */}
        <header className="flex items-center justify-between mb-6 pb-4 border-b border-white/10">
          <div>
            <InkText
              className="text-3xl font-bold tracking-widest bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent"
              intensity={3}
              bleed={2}
              frequency={0.05}
            >
              {level.title}
            </InkText>
            <p className="text-xs text-gray-400/80 mt-1 uppercase tracking-wider">
              Nivel {level.id} / {totalLevels}
            </p>
          </div>
          <div className="w-20 h-2 bg-white/10 rounded-full overflow-hidden">
            <div
              className="h-full bg-gradient-to-r from-purple-500 to-blue-500 transition-all duration-500"
              style={{ width: `${progress}%` }}
            />
          </div>
        </header>

        {/* Pista y media */}
        <section className="text-center my-6 space-y-4">
          <InkText
            className="text-lg text-gray-200/90"
            intensity={2}
            bleed={1.5}
            frequency={0.06}
          >
            {level.clue}
          </InkText>
          <RiddleMedia media={level.media} />
        </section>

        {/* Formulario */}
        <form onSubmit={handleSubmit} className="mt-8 flex flex-col items-center gap-4">
          <div className="w-full max-w-md relative">
            <input
              type="text"
              value={userInput}
              onChange={(e) => {
                setUserInput(e.target.value);
                if (error) setError(false);
              }}
              placeholder="Introduce la clave..."
              className={`
                w-full px-5 py-3
                bg-white/5 backdrop-blur-sm
                border rounded-xl
                text-white placeholder-gray-400/60
                focus:outline-none focus:ring-2
                transition-all duration-300
                ${error
                  ? "border-red-500/80 focus:ring-red-500/50 animate-shake"
                  : "border-white/20 focus:border-purple-400 focus:ring-purple-400/40"
                }
              `}
            />
            {error && (
              <p className="absolute -bottom-6 left-0 text-xs text-red-400 font-mono animate-pulse">
                ⚠️ ACCESO DENEGADO — Clave incorrecta
              </p>
            )}
          </div>

          <button
            type="submit"
            className="
              px-10 py-3
              bg-gradient-to-r from-purple-600 to-blue-600
              hover:from-purple-500 hover:to-blue-500
              text-white font-bold uppercase tracking-widest text-sm
              rounded-xl
              shadow-[0_4px_20px_rgba(108,60,224,0.4)]
              hover:shadow-[0_8px_30px_rgba(108,60,224,0.6)]
              transition-all duration-300
              transform hover:scale-105 active:scale-95
            "
          >
            Enviar
          </button>
        </form>

        {/* Mensaje de éxito (opcional) */}
        {!error && userInput && (
          <p className="mt-4 text-center text-emerald-400 text-sm font-mono animate-fade-in">
            🔓 Clave aceptada
          </p>
        )}
      </main>
    </div>
  );
}
